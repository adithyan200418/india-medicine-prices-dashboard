table medicine_price_change_2022_2025
	lineageTag: 875913d2-dab4-4bf9-90da-919fa7d882e5

	/// Medicines found in both the 2022 catalogue and the 2025 scrape.
	measure 'Medicines Compared' = COUNTROWS('medicine_price_change_2022_2025')
		formatString: #,0
		displayFolder: Wholesale prices
		lineageTag: ad938fc9-4247-5132-b9b2-d28c8518dd3c

	/// Typical change in a medicine's listed price between 2022 and 2025.
	measure 'Median Price Change' = DIVIDE(MEDIAN('medicine_price_change_2022_2025'[change_pct]), 100)
		formatString: +0.0%;-0.0%
		displayFolder: Wholesale prices
		lineageTag: 70540021-e305-5436-923a-9ebded56cb92

	/// Share of compared medicines whose price rose.
	measure 'Share Increased' = DIVIDE(CALCULATE(COUNTROWS('medicine_price_change_2022_2025'), 'medicine_price_change_2022_2025'[direction] = "Increased"), COUNTROWS('medicine_price_change_2022_2025'))
		formatString: 0%
		displayFolder: Wholesale prices
		lineageTag: d6d1c6f8-08dd-59ce-ae33-62d53ab4578f

