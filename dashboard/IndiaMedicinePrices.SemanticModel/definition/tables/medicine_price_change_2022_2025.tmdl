	partition medicine_price_change_2022_2025 = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\medicine_price_change_2022_2025.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"medicine_id", "medicine", "manufacturer", "molecule", "therapeutic_class", "dosage_form", "prescription_required", "price_2022_inr", "mrp_2025_inr", "change_pct", "direction"}),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"medicine_id", type text}, {"medicine", type text}, {"manufacturer", type text}, {"molecule", type text}, {"therapeutic_class", type text}, {"dosage_form", type text}, {"prescription_required", type text}, {"price_2022_inr", type number}, {"mrp_2025_inr", type number}, {"change_pct", type number}, {"direction", type text}}, "en-US")
				in
				    Typed

