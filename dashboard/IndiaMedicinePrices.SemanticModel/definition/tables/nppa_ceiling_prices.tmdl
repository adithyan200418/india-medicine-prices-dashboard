table nppa_ceiling_prices
	lineageTag: 4320b22e-2944-465f-b8e2-f5dd0c073e00

	/// Formulations with a government ceiling price in the listed NPPA orders.
	measure 'Price-Controlled Formulations' = COUNTROWS('nppa_ceiling_prices')
		formatString: #,0
		displayFolder: Market
