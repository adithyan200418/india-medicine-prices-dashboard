	partition nppa_ceiling_prices = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\nppa_ceiling_prices.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"serial", "list_year", "drug", "form_and_strength", "dosage_form", "ceiling_price_inr", "price_unit", "order_number"}),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"serial", Int64.Type}, {"list_year", Int64.Type}, {"drug", type text}, {"form_and_strength", type text}, {"dosage_form", type text}, {"ceiling_price_inr", type number}, {"price_unit", type text}, {"order_number", type text}}, "en-US")
				in
				    Typed

