		lineageTag: 6d968d72-c80d-4486-afd1-7ae5f361e76d
		summarizeBy: none
		sourceColumn: source_url

	partition pharma_market_growth_2026 = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\pharma_market_growth_2026.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"period", "basis", "metric", "value_pct", "data_provider", "verification", "source_url"}),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"period", type date}, {"basis", type text}, {"metric", type text}, {"value_pct", type number}, {"data_provider", type text}, {"verification", type text}, {"source_url", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

