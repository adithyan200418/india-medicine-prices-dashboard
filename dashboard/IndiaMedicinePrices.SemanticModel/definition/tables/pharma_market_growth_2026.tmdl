		lineageTag: 2f12807c-aadc-4576-9027-70d98d689af2
		summarizeBy: none
		sourceColumn: value_pct

	column data_provider
		dataType: string
		lineageTag: 5c25ce75-bc82-40ee-bcad-0b14956a741d
		summarizeBy: none
		sourceColumn: data_provider

	column verification
		dataType: string
		lineageTag: 98b791e4-caba-45ab-9df0-e35447ef7c6d
		summarizeBy: none
		sourceColumn: verification

	column source_url
