table pharma_market_growth_2026
	lineageTag: 7c3ca533-c853-45bb-a021-d5888b31bbe0

	/// Retail pharma market growth in the quarter to January 2026, split by cause.
	measure 'Market Growth Jan 2026' = DIVIDE(CALCULATE(AVERAGE('pharma_market_growth_2026'[value_pct]), 'pharma_market_growth_2026'[basis] = "Quarter ending Jan 2026"), 100)
		formatString: 0.0%
		displayFolder: Availability
		lineageTag: cbb610a1-60e6-585c-bb48-ee0b805f3ea0

	/// Part of market growth that came from higher prices.
	measure 'Market Price Growth' = CALCULATE([Market Growth Jan 2026], 'pharma_market_growth_2026'[metric] = "Price growth")
		formatString: 0.0%
		displayFolder: Availability
		lineageTag: e265bc9e-9d13-5d22-9f98-bc21264874d0

	/// Part of market growth that came from more units sold.
	measure 'Market Volume Growth' = CALCULATE([Market Growth Jan 2026], 'pharma_market_growth_2026'[metric] = "Volume growth")
		formatString: 0.0%
		displayFolder: Availability
		lineageTag: edce57d6-cfcb-55a5-bfcf-1ef5319f1806

	column period
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 55d8092c-83c9-47ca-b192-50b54ec1d3de
		summarizeBy: none
		sourceColumn: period

		annotation UnderlyingDateTimeDataType = Date

	column basis
		dataType: string
		lineageTag: 8223f5f8-afe2-495d-814f-8b48cb4f7a5c
		summarizeBy: none
		sourceColumn: basis

	column metric
